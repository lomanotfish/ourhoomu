{
  "name": "@ourhoomu/api",
  "private": true,
  "type": "module",
  "engines": {
    "bun": ">=1.4.3",
    "node": ">=22"
  },
  "scripts": {
    "dev": "wrangler dev --config wrangler.jsonc",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "lint": "biome lint --error-on-warnings .",
    "typecheck": "tsc --noEmit",
    "check:runtime": "bun scripts/runtime-check.ts",
    "check:fixture-runtime": "bun scripts/runtime-check.ts --fixture",
    "prepare:neon-runtime": "bun tests/fixtures/prepare-neon-runtime.ts",
    "check:neon-runtime": "bun tests/fixtures/check-neon-runtime.ts",
    "test": "bun test tests",
    "build:worker": "WRANGLER_SEND_METRICS=false node node_modules/wrangler/bin/wrangler.js deploy --dry-run --config wrangler.jsonc --outdir dist/worker"
  },
  "dependencies": {
    "@neondatabase/serverless": "1.2.0",
    "drizzle-orm": "0.45.4",
    "elysia": "1.4.30",
    "jose": "6.2.10",
    "@ourhoomu/contracts": "workspace:*",
    "@sinclair/typebox": "0.34.52"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "@cloudflare/workers-types": "5.20261013.1",
    "@types/bun": "1.3.10",
    "typescript": "7.0.2",
    "wrangler": "4.150.0"
  }
}
