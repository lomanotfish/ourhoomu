{
  "name": "ourhoomu-front",
  "version": "0.1.0",
  "private": true,
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "typecheck": "tsc --noEmit",
    "format:check": "prettier --check 'app/**/*.{ts,tsx}' 'src/**/*.{ts,tsx}' '*.js' '*.json'",
    "format": "prettier --write 'app/**/*.{ts,tsx}' 'src/**/*.{ts,tsx}' '*.js' '*.json'",
    "export:web": "expo export --platform web",
    "export:ios": "expo export --platform ios",
    "test": "bun test"
  },
  "dependencies": {
    "expo": "57.0.28",
    "expo-constants": "~57.0.21",
    "expo-font": "~57.0.4",
    "expo-linking": "~57.0.12",
    "expo-router": "~57.0.26",
    "expo-status-bar": "~57.0.1",
    "lucide-react-native": "^1.55.0",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.3",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-svg": "15.15.4",
    "react-native-web": "^0.21.2"
  },
  "devDependencies": {
    "@types/bun": "^1.4.3",
    "@types/react": "~19.2.4",
    "prettier": "^3.9.10",
    "typescript": "~6.0.3"
  }
}
